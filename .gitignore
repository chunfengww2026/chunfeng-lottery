# ============================================================
#  仓库根的 .gitignore
#
#  【为什么需要它】云端（GitHub Actions）每一班跑完都会
#    git add -A cloud/  →  commit  →  push 回仓库。
#  以前 cloud/out/index.html（1.27 MB）/ football.html 也在提交范围里，
#  等于【每跑一班就往仓库塞一个 1.27 MB 的网页】。
#  定时改成「每 30 分钟一班」后一天 48 次，仓库会迅速膨胀到没法用。
#
#  【注意】部署用的是运行时生成的 site/ 目录（workflow 里从 cloud/out/ 拷过去），
#  和这些文件在不在版本管理里【完全无关】；
#  万一某次构建没产出页面，workflow 会从线上把当前那份拉回来兜底。
# ============================================================

# 构建产物的两个大页面（每次构建都会重新生成）
cloud/out/index.html
cloud/out/football.html
cloud/scripts/只读分享版.html
cloud/scripts/足球推荐.html

# 抓取脚本的临时/退避/日志文件（每次构建都会变，没有版本价值）
cloud/scripts/_*.log
cloud/scripts/_*.json
cloud/scripts/_draw-cache/
cloud/scripts/_ocr-cache/
cloud/scripts/分享包/

# 图标生成过程中的中间尺寸（BOM / 调试用）：
# 真正要发布的是 favicon.ico（16/32/48 全在里面）+ icon-192/512 +
# apple-touch-icon + share.png；favicon-16/32/48.png 只是 make-icons.py
# 顺手输出的中间产物，不需要进仓库（make-icons.mjs 也不会分发它们）。
cloud/scripts/icons/favicon-16.png
cloud/scripts/icons/favicon-32.png
cloud/scripts/icons/favicon-48.png

# 【票图校验】OCR 判定缓存的【本机运行态】文件：
#  · 每张图一条 {ok, why, text, ms, at}，几百 KB 且每轮都在变
#  · 云端不需要它（云端自己会重新校验/或直接用数据），
#    传上去只会让仓库每轮都涨一个 60~200 KB 的文件
#  · 代码（verify-ticket.mjs）会同步到云端；缓存不传
_ticket-ocr-cache.json

# ============================================================
# 【密钥 · 红线】2026-10-19
# ai-config.js 里有【明文 API Key】（方舟 ark-c72b… / DeepSeek sk-726c…）。
# 实测核实它【没有】进过 git，也没有上云：
#   · GitHub 仓库 main 上 ai-config.js / cloud/ai-config.js /
#     cloud/scripts/ai-config.js 三个路径全是 404
#   · cloud/sync-cloud.mjs 只把它列在「本机 App 专属，绝不上云」的自检名单里，
#     不在任何上传清单（FROM_ROOT / CODE_MODULES / PAGE_ARTIFACTS）里
# 这里再加一道：以后在这个目录建 git 仓库 / 提交时【永远】带上它不进去。
# ⚠️ 绝不删掉这几行。真要换 Key 就改 ai-config.js 本身，或设环境变量
#    ARK_API_KEY / DEEPSEEK_API_KEY（见 ai-config.js 末尾的说明）。
# ============================================================
ai-config.js
**/ai-config.js
# 同类的本机密钥/凭据文件（一个都不许进仓库）
ai-keys*.js
ai-keys*.json
*.key
*secret*.json
# 本机 GitHub Token（sync-cloud 用它推送，绝对不能上云）
cloud/cloud-token.txt

